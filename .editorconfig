# MJ 11.12.5 — the formatting contract for every editor that touches this tree.
# Style follows the code as shipped: 2-space indents, double quotes, semicolons,
# trailing commas. Probes grep source text, so keep lines explicit rather than
# auto-rewrapped.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{rs,toml}]
indent_size = 4

[Makefile]
indent_style = tab
